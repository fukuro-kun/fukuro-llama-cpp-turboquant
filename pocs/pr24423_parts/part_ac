+                   P, (int) answer.size(), prompt_prepare_ms, wall_ms, decode_ms,
+                   blocks_run, total_steps, (int) canvas_length, MAXTOK);
+            fflush(stdout);
+        }
+        printf("DONE\n"); fflush(stdout);
+    }
+
+    llama_free(ctx);
+    llama_model_free(model);
+    llama_backend_free();
+    return 0;
+}
