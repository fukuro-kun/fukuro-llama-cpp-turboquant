[Unit]
Description=Gemma-4 26B-A4B QAT Server (mars) — 224k ctx, turbo4/3, Vulkan
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/fukuro/git/fukuro-llama-cpp-turboquant
ExecStart=/home/fukuro/git/fukuro-llama-cpp-turboquant/scripts/run-gemma4-26b-a4b-mars-server.sh
ExecStop=/bin/kill -TERM $MAINPID
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=30
MemoryPressureWatch=no

[Install]
WantedBy=default.target
