[Unit]
Description=Gemma-4 26B-A4B MTP Server (Pascal-Host) with thecodacus Pinning+Prefetch
After=network.target

[Service]
Type=simple
ExecStart=/path/to/fukuro-llama-cpp-turboquant/scripts/run-gemma4-26b-a4b-mtp-Pascal-Host-server.sh
Restart=on-failure
RestartSec=10
MemoryMax=10G
Environment=GGML_CUDA_REGISTER_HOST=1
Environment=GGML_SCHED_PREFETCH_EXPERTS=1

[Install]
WantedBy=default.target
